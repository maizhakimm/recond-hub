# ---- Google Sheets (leave empty to run on /data/sample CSVs) ----
# Service account JSON: paste the whole JSON on one line, or base64-encode it.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long id in the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# ---- On-demand refresh (used by the Apps Script "Refresh website" button) ----
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.recondhub.my
NEXT_PUBLIC_BRAND_NAME=RecondHub
NEXT_PUBLIC_LEGAL_NAME=RecondHub Sdn. Bhd.
NEXT_PUBLIC_CONTACT_EMAIL=hello@recondhub.my
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@kingofrecond

# ---- Analytics (each pixel loads only when set) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ---- Fallbacks if the Settings tab is missing or invalid ----
FALLBACK_HQ_WHATSAPP=
FALLBACK_OWNER_WHATSAPP=
